# Copy this file to .env.local and fill in the values.
# .env.local is ignored by Git, so your real keys never reach GitHub.

# MongoDB Atlas connection string (Step 3)
MONGODB_URI=

# NextAuth / Google sign-in (Step 4)
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Gemini API key from Google AI Studio (Step 5)
GEMINI_API_KEY=
# Optional: override the embedding model (defaults to gemini-embedding-001)
# GEMINI_EMBEDDING_MODEL=

# Pinecone vector database (Step 5)
PINECONE_API_KEY=
PINECONE_INDEX_NAME=youtube-rag-qa
